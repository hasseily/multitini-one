* text=auto

*.sv text eol=lf
*.v text eol=lf
*.vhd text eol=lf
*.vhdl text eol=lf
*.xdc text eol=lf
*.tcl text eol=lf
*.c text eol=lf
*.h text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.md text eol=lf
Makefile text eol=lf
CMakeLists.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
hdl/common/multitini_font7x8.mem text eol=lf

# Preserve imported source byte-for-byte, including upstream whitespace.
third_party/appletini/** -whitespace
third_party/apple-iigs/upstream/** -text -whitespace
licenses/third_party/CiderPress2/LICENSE -text
licenses/third_party/CiderPress2/NOTICE -text
third_party/c64/upstream/** -text -whitespace
third_party/mame_reference/upstream/** -text -whitespace
third_party/vice_reference/upstream/** -text -whitespace
third_party/ultimate_reference/upstream/** -text -whitespace
third_party/gameboy/upstream/** -text -whitespace
third_party/genesis/upstream/** -text -whitespace
third_party/nes/upstream/** -text -whitespace
third_party/gsbasic/** -text -whitespace
third_party/vectrex/** -text -whitespace
third_party/vectrex32/** -text -whitespace

# Keep the VICE comparison harness bytes stable across Windows checkouts.
tests/c64_vice/*.cpp text eol=lf

# Preserve the exact hashes recorded for these imported USB source ports.
firmware/platform/xilinx/usb_storage_service.c -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
firmware/platform/xilinx/usb_storage_service.h -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
firmware/platform/xilinx/usb_storage_sd.c -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
firmware/platform/xilinx/usb_storage_backend.h -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
firmware/platform/xilinx/gic_init.c -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
firmware/platform/xilinx/gic_init.h -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
firmware/platform/xilinx/usb0_personality.h -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Local compatibility ports intentionally preserve upstream whitespace.
hdl/board/multitini_psram_driver.sv -whitespace
hdl/core/c64/ports/cartridge.sv -whitespace
hdl/core/c64/ports/fpga64_sid_iec.vhd -whitespace
hdl/core/c64/ports/T65.vhd -whitespace
