* text=auto

*.sv text eol=lf
*.v text eol=lf
*.vhd text eol=lf
*.vhdl text eol=lf
*.xdc text eol=lf
*.tcl text eol=lf
*.c text eol=lf
*.h text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.md text eol=lf
Makefile text eol=lf
CMakeLists.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
hdl/common/multitini_font7x8.mem text eol=lf

# Preserve imported source byte-for-byte, including upstream whitespace.
third_party/appletini/** -whitespace
third_party/c64/upstream/** -text -whitespace
third_party/gameboy/upstream/** -text -whitespace
third_party/gsbasic/** -text -whitespace
third_party/vectrex/** -text -whitespace
third_party/vectrex32/** -text -whitespace

# Local compatibility ports intentionally preserve upstream whitespace.
hdl/board/multitini_psram_driver.sv -whitespace
hdl/core/c64/ports/cartridge.sv -whitespace
hdl/core/c64/ports/fpga64_sid_iec.vhd -whitespace
hdl/core/gameboy/ports/gbc_snd.vhd -whitespace
