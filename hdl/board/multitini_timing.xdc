# SPDX-License-Identifier: GPL-3.0-only
################################################################################
# Multitini One clocks and external timing intent
#
# Hierarchical query cardinality is checked by build_and_export_xsa.tcl after
# the implemented design is opened. This XDC is implementation-only because
# the clock-wizard hierarchy is still black-boxed during top-level synthesis.
################################################################################

# Board audio oscillator: 12.288 MHz.
create_clock -period 81.380 -name audio_mclk [get_ports audio_i2s_mclk]

# I2S BCLK is audio_mclk / 4. The divider register name is owned by the shell.
set audio_bclk_source [get_pins -hierarchical -quiet -regexp \
    {.*audio_test/audio_bclk_div_reg\[1\]/Q}]
create_generated_clock -name audio_bclk \
    -source [get_ports audio_i2s_mclk] -divide_by 4 $audio_bclk_source

# The forwarded BICK is the sampling clock at the AK4493S. Normal PCM mode
# requires LRCK and SDATA to meet 5 ns setup and 5 ns hold at each rising BICK
# edge (AK4493S datasheet 211100143-E-02, 2022/03, pp. 27 and 31). Both signals
# change on BICK's falling edge in the transmitter, leaving a half-cycle for
# the source-synchronous output path. These constraints cover FPGA-pin timing;
# production signoff must also account for measured or layout-derived board
# skew.
create_generated_clock -name audio_bclk_out \
    -source $audio_bclk_source -divide_by 1 [get_ports audio_i2s_bick]
set audio_pcm_ports [get_ports {audio_i2s_lrck audio_i2s_sdata}]
set_output_delay -clock audio_bclk_out -max 5.0 $audio_pcm_ports
set_output_delay -clock audio_bclk_out -min -5.0 $audio_pcm_ports

# The TFP410 is strapped for single-edge rising-edge sampling. The ODDR sends
# the rising forwarded edge one half pixel after the data launch. Receiver
# requirements are TFP410 rev. D single-edge values: 1.2 ns setup, 1.3 ns hold.
set dvi_oddr_c [get_pins -hierarchical -quiet \
    -filter {NAME =~ *video_test/dvi_clk_oddr/C}]
create_generated_clock -name dvi_clk_out -source $dvi_oddr_c \
    -edges {2 3 4} [get_ports dvi_clk]
set dvi_data_ports [get_ports \
    {dvi_red[*] dvi_grn[*] dvi_blu[*] dvi_de dvi_hsync dvi_vsync}]
set_output_delay -clock dvi_clk_out -max 1.2 $dvi_data_ports
set_output_delay -clock dvi_clk_out -min -1.3 $dvi_data_ports

# Clock-wizard clock names are generated by the tracked block design. Use
# object-count assertions so hierarchy drift cannot silently drop an exception.
set control_root_clock [get_clocks -quiet \
    -filter {NAME =~ *clk_out1*zynq_ps_bd_clk_wiz_control*}]
set video_root_clock [get_clocks -quiet \
    -filter {NAME =~ *clk_out1*zynq_ps_bd_clk_wiz_video*}]
# The block-design cell keeps its historical c64 name but generates the active
# build-selected C64 or GBC machine clock.
set machine_root_clock [get_clocks -quiet \
    -filter {NAME =~ *clk_out1*zynq_ps_bd_clk_wiz_c64*}]
set control_clocks [get_clocks -quiet -include_generated_clocks \
    $control_root_clock]
set video_clocks [get_clocks -quiet -include_generated_clocks \
    $video_root_clock]
set machine_clocks [get_clocks -quiet -include_generated_clocks \
    $machine_root_clock]
set audio_clocks [get_clocks -quiet -include_generated_clocks audio_mclk]
set_clock_groups -asynchronous \
    -group $control_clocks -group $video_clocks -group $machine_clocks \
    -group $audio_clocks

# S/PDIF is self-clocking biphase-mark data and has no separate receiver
# sampling clock against which an FPGA output delay can be specified.
set_false_path -to [get_ports audio_spdif_out]

# Raw Apple connector inputs are deliberately not clocks in standalone mode.
# They only feed an unused-input reduction and are excluded from timing. No
# timing exception is applied to Apple outputs: those must remain constants.
set_false_path -from [get_ports \
    {a2fpga_clk a2fpga_7m a2fpga_q3 a2fpga_m2b0 a2fpga_m2sel \
     a2fpga_devsel_n a2fpga_dma_n a2fpga_rdy_n a2fpga_inh_n \
     a2fpga_nmi_n a2fpga_reset_n a2fpga_irq_n a2fpga_a[*] a2fpga_d[*] \
     a2fpga_rdwr_n}]

# Static status inputs are not used to control this diagnostic image.
set_false_path -from [get_ports \
    {dvi_hpd i2c0_rtc_int_n i2c0_rtc_clkout i2c0_temp_alert_n \
     eth_int_n usb_sys_fault_n}]

# PSRAM is held inactive by default. The opt-in GBC source branch is bring-up
# preparation only: it has no accepted external interface timing here. Do not
# program an enabled build until the controller/capture mode, I/O delays, clock
# relationship, tap choice, and board measurements have been reviewed.

set_property CONFIG_VOLTAGE 3.3 [current_design]
set_property CFGBVS VCCO [current_design]
