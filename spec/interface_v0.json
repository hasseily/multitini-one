  "media_contract": {
    "request": {
      "unit_bytes": 256,
      "rule": "VALID, WRITE, ID, LBA, BLOCK_COUNT, and GENERATION remain stable until a matching MEDIA_COMPLETE pulse",
      "read_payload": "For WRITE=0, software sends exactly BLOCK_COUNT*256 bytes through the load stream before MEDIA_COMPLETE; ABI 0.8 adds packed four-byte STREAM_DATA_BURST writes with STREAM_STATUS backpressure while retaining the byte-command path",
      "write_payload": "For WRITE=1, each MMIO read of MEDIA_DATA with VALID=1 returns and consumes one byte in bits[15:8]; LAST is set only on byte BLOCK_COUNT*256-1"
    },
    "commands": {
      "MEDIA_MOUNT": {
        "arg0": "slot[7:0] | kind[15:8] | read_only[16]; bits[31:17] zero",
        "arg1": "nonzero image size in bytes",
        "arg2": "nonzero mount generation",
        "arg3": "zero"
      },
      "MEDIA_EJECT": {
        "arg0": "slot[7:0]; bits[31:8] zero",
        "arg1": "new nonzero generation for the empty slot",
        "arg2": "zero",
        "arg3": "zero"
      },
      "MEDIA_COMPLETE": {
        "arg0": "request ID",
        "arg1": "MT_RESPONSE_OK, MT_RESPONSE_INVALID_ARGUMENT, MT_RESPONSE_IO_ERROR, or MT_RESPONSE_TIMEOUT",
        "arg2": "For OK, the exact completed 256-byte block count in bits[15:0] with bits[31:16] zero; for failure, zero",
        "arg3": "mount generation"
      }
    },
    "state": "MEDIA_STATE reports the synchronized core mount, dirty, and deferred-eject state"
  },
  "uci_contract": {
    "buffer": "2048 bytes; command[0:895], response[896:1791], status[1792:2047]; aligned little-endian AXI single words only",
    "idle_abort": "STATUS[29] is sticky until tagged op6; a simultaneous new abort wins acknowledgment. STATUS2[30] is CMD_BUSY. STATUS2[29:28] reserved. No wrapping idle-abort counter.",
    "ordering": "Read STATUS then latched STATUS2. Drain buffer writes before sending a tagged operation; wait for op_ack before another operation.",
    "ram": "Kind0x17 transfers little-endian address then data with no guest reset, under acknowledged whole-machine HOLD; RAM_READ request uses the same hold and returns data at buffer reply offset."
  }
}
